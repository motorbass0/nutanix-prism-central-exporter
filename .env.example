# Copy to .env (never commit it) and set: chmod 600 .env
# Values without quotes (Docker does not strip them).

# Required: read-only Prism Central account, shared by all targets
PRISM_USER=svc-prometheus
PRISM_PASSWORD=changeme

# Optional (defaults shown)
# PRISM_EXPORTER_PORT=9421
# PRISM_TIMEOUT=20

# Optional: CA bundle to verify Prism Central certificates.
# With Docker, this is the path INSIDE the container (mount the file in docker-compose.yml).
# PRISM_CA_FILE=/etc/nutanix-prism-central-exporter/ca.pem
